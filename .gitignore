# See http://help.github.com/ignore-files/ for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.pnpm-store/

# IDEs and editors
.idea/
.vs/
.fleet/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code (local workspace settings)
.vscode/
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/test-results
/playwright-report
/blob-report
/screenshots
/libpeerconnection.log
testem.log
/typings
.eslintcache

# Local configuration and secrets
.env
.env.*
!.env.example
src/environments/environment.local.ts
src/environments/environment.development.local.ts

# Logs and temporary files
logs/
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# System files
.DS_Store
Thumbs.db
Desktop.ini
*.stackdump
